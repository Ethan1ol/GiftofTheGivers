<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gift of the Givers</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="shadow-sm bg-white sticky-top">
<nav class="navbar navbar-expand-lg">
<div class="container">
<a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-page="/Index">
<span class="brand-mark">G</span> Gift of the Givers
</a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse" id="nav">
<ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
<li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
<li class="nav-item"><a class="nav-link" asp-page="/About">About</a></li>
<li class="nav-item"><a class="nav-link" asp-page="/Donations/Create">Donate</a></li>
<li class="nav-item"><a class="nav-link" asp-page="/Volunteer/Register">Volunteer</a></li>
<li class="nav-item"><a class="nav-link" asp-page="/Contact">Contact</a></li>
@if (User.IsInRole("Employee")) {
<li class="nav-item"><a class="btn btn-dark btn-sm px-3" asp-page="/Employee/Dashboard">Employee Dashboard</a></li>
}
@if (User.Identity?.IsAuthenticated == true) {
<li class="nav-item"><form method="post" asp-page="/Account/Logout"><button class="btn btn-outline-secondary btn-sm">Logout</button></form></li>
} else {
<li class="nav-item"><a class="btn btn-success btn-sm px-3" asp-page="/Account/Login">Login</a></li>
}
</ul>
</div></div></nav>
</header>
<main>@RenderBody()</main>
<footer class="footer mt-5"><div class="container py-4 d-flex justify-content-between flex-wrap gap-2"><span>© 2026 Gift of the Givers Prototype</span><span>Compassion • Relief • Hope</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>